      "type": "object",
      "properties": {
        "type": {
          "const": "room.snapshot"
        },
        "roomId": {
          "$ref": "./models.schema.json#/$defs/Id"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "capturedAt": {
          "$ref": "./models.schema.json#/$defs/Time"
        },
        "data": {
          "$ref": "./models.schema.json#/$defs/SnapshotData"
        }
      },
      "required": [
        "type",
        "roomId",
        "cursor",
        "capturedAt",
        "data"
      ],
      "additionalProperties": false
    },
    "member_joined": {
      "type": "object",
      "properties": {
        "type": {
          "const": "member.joined"
        },
        "eventId": {
          "$ref": "./models.schema.json#/$defs/Id"
        },
        "roomId": {
          "$ref": "./models.schema.json#/$defs/Id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "$ref": "./models.schema.json#/$defs/Time"
        },
        "data": {
          "type": "object",
          "properties": {
            "member": {
              "$ref": "./models.schema.json#/$defs/ActiveMember"
            }
          },
          "required": [
            "member"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "eventId",
        "roomId",
        "sequence",
        "occurredAt",
        "data"
      ],
      "additionalProperties": false
