        "occurredAt": {
          "$ref": "./models.schema.json#/$defs/Time"
        },
        "data": {
          "type": "object",
          "properties": {
            "invocation": {
              "allOf": [
                {
                  "$ref": "./models.schema.json#/$defs/Invocation"
                },
                {
                  "properties": {
                    "status": {
                      "const": "running"
                    }
                  }
                }
              ]
            },
            "reply": {
              "allOf": [
                {
                  "$ref": "./models.schema.json#/$defs/AIReply"
                },
                {
                  "properties": {
                    "status": {
                      "const": "streaming"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "invocation",
            "reply"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "eventId",
        "roomId",
        "sequence",
        "occurredAt",
        "data"
      ],
      "additionalProperties": false
